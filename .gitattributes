# Đảm bảo line ending LF cho tất cả file text
* text=auto eol=lf

# Ép buộc LF cho các file cấu hình quan trọng
*.sh text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.env* text eol=lf
