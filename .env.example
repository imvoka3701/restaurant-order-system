# ====================================================================
# Biến môi trường cho Hệ thống Quản lý Nhà hàng
# Sao chép file này thành .env và điền mật khẩu thật
# Sử dụng mật khẩu mạnh >= 16 ký tự, bao gồm chữ hoa, thường, số
# ====================================================================

# --- PostgreSQL ---
POSTGRES_DB=restaurant_db
POSTGRES_USER=postgres
# Mật khẩu superuser PostgreSQL (>= 16 ký tự)
POSTGRES_PASSWORD=change_me_strong_password_16

# --- App Database User (least privilege) ---
APP_DB_USER=app_user
# Mật khẩu cho app_user (>= 16 ký tự)
APP_DB_PASS=change_me_app_password_16

# --- Exporter User (dùng cho Prometheus ở phase sau) ---
EXPORTER_DB_PASS=change_me_exporter_pass_16

# --- pgAdmin ---
# LƯU Ý: Email phải là email hợp lệ (KHÔNG dùng đuôi .local)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASS=change_me_pgadmin_pass_16

# --- Grafana (Phase 2) ---
GRAFANA_ADMIN_USER=admin
# Mật khẩu quản trị Grafana (>= 16 ký tự, mật khẩu mạnh)
GRAFANA_ADMIN_PASS=change_me_grafana_pass_16
